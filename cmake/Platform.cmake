if(WIN32)
  target_sources(mapkern_core PRIVATE src/net/http_win.cpp)
  target_link_libraries(mapkern_core PUBLIC winhttp)
elseif(APPLE)
  target_sources(mapkern_core PRIVATE src/net/http_apple.mm)
  set_source_files_properties(src/net/http_apple.mm PROPERTIES COMPILE_FLAGS "-fobjc-arc")
  target_link_libraries(mapkern_core PUBLIC "-framework Foundation")
elseif(ANDROID)
  target_sources(mapkern_core PRIVATE src/net/http_android.cpp)
  target_link_libraries(mapkern_core PUBLIC log android)
else()
  find_package(CURL REQUIRED)
  target_sources(mapkern_core PRIVATE src/net/http_curl.cpp)
  target_link_libraries(mapkern_core PUBLIC CURL::libcurl)
endif()
