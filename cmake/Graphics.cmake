if(APPLE)
  target_sources(mapkern PRIVATE src/render/sokol_impl.mm)
  set_source_files_properties(src/render/sokol_impl.mm PROPERTIES COMPILE_FLAGS "-fobjc-arc")
  target_link_libraries(mapkern PUBLIC "-framework Metal" "-framework MetalKit" "-framework QuartzCore")
  if(IOS)
    target_link_libraries(mapkern PUBLIC "-framework UIKit")
  else()
    target_link_libraries(mapkern PUBLIC "-framework Cocoa")
  endif()
else()
  target_sources(mapkern PRIVATE src/render/sokol_impl.cpp)
endif()

if(WIN32)
  target_link_libraries(mapkern PUBLIC d3d11 dxgi)
elseif(ANDROID)
  target_link_libraries(mapkern PUBLIC GLESv3 EGL)
elseif(NOT APPLE)
  if(MAPKERN_GFX STREQUAL "GLES3")
    target_link_libraries(mapkern PUBLIC GLESv2 EGL)
  else()
    find_package(OpenGL REQUIRED)
    target_link_libraries(mapkern PUBLIC OpenGL::GL)
  endif()
  target_link_libraries(mapkern PUBLIC ${CMAKE_DL_LIBS})
endif()
