<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Mapkern.WinForms</RootNamespace>
    <PackageId>Mapkern.Native.WinForms</PackageId>
    <Version>0.1.0</Version>
    <Authors>grangedevgroup</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>WinForms map control for Mapkern Native.</Description>
    <PackageProjectUrl>https://github.com/grangedevgroup-code/mapkern-native</PackageProjectUrl>
    <RepositoryUrl>https://github.com/grangedevgroup-code/mapkern-native</RepositoryUrl>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mapkern/Mapkern.csproj" />
  </ItemGroup>
</Project>
